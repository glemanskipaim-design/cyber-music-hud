#include <windows.h>
#include "resource.h"

IDI_APP ICON "assets/app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "src/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "FileDescription", "Cyber Music HUD"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "CyberMusicHUD"
            VALUE "OriginalFilename", "CyberMusicHUD.exe"
            VALUE "ProductName", "Cyber Music HUD"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
